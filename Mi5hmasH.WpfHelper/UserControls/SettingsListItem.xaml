<UserControl x:Class="Mi5hmasH.WpfHelper.UserControls.SettingsListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root">
    <Border 
        d:BorderBrush="Black" 
        d:BorderThickness="2"
        CornerRadius="5"
        Padding="10"
        Margin="0,0,0,10"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- ICON -->
            <TextBlock FontFamily="{Binding IconFont, ElementName=Root}"
                       FontSize="25" VerticalAlignment="Center" Margin="5,0,15,0"
                       Text="{Binding Icon, ElementName=Root}" />
            <!-- DESCRIPTION -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" 
                           Text="{Binding Title, ElementName=Root}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" 
                           Text="{Binding Caption, ElementName=Root}" />
            </StackPanel>
            <!-- SETTING -->
            <ContentPresenter Grid.Column="2"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center"
                              Content="{Binding SettingControl, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
